{
  "name": "qa-security-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:security": "playwright test tests/security",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "python3 -m http.server 8080 --directory allure-report --bind 0.0.0.0",
    "test:security:report": "npm run test:security && npm run allure:generate",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "^8.0.0-rc.14",
    "dotenv": "^18.0.6",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^8.0.0-rc.20",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}